{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".tsbuild",
    "pnpm-lock.yaml",
    "datasets/**",
    "**/*.md",
    "docs/presentation/**"
  ],
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 100,
  "singleAttributePerLine": true,
  "htmlWhitespaceSensitivity": "ignore"
}
