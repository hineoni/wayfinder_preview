{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/arch-check/fixtures/**"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "unlisted": "error",
    "unresolved": "error",
    "dependencies": "error",
    "devDependencies": "error"
  },
  "workspaces": {
    ".": {},
    "tools/arch-check": {
      "ignoreDependencies": ["valibot"]
    }
  }
}
